APP_NAME=STEH
APP_ENV=local
LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg://steh:steh@postgres:5432/steh
LANGGRAPH_DATABASE_URL=postgresql://steh:steh@postgres:5432/steh?sslmode=disable

LLM_MODE=stub
LLM_MODEL=gpt-5-mini
OPENAI_API_KEY=

POLICY_FILE=policies/quality-gates.yaml

AUTH_ENABLED=false
AUTH_JWT_SECRET=change-me-local-only
AUTH_JWT_ALGORITHM=HS256
AUTH_REQUIRED_ROLE=steh_user
AUTH_REVIEWER_ROLE=steh_reviewer
HUMAN_REVIEW_TTL_MINUTES=60

CONTEXT_MAX_SOURCES=10
CONTEXT_MAX_TOKENS=4000
CONTEXT_MAX_SOURCE_TOKENS=2000

GITHUB_API_URL=https://api.github.com
GITHUB_API_VERSION=2026-03-10
GITHUB_TOKEN=
GITHUB_TIMEOUT_SECONDS=10
GITHUB_ISSUE_MAX_BODY_CHARS=20000
GITHUB_ALLOWED_REPOSITORIES=fabioestevam2404/steh-v1.0.0-rc1
